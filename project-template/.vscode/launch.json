{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SCRIMP: first simulation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulations/first_simulation.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
