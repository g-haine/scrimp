{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SCRIMP: run first simulation",
      "type": "shell",
      "command": "python",
      "args": [
        "simulations/first_simulation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "SCRIMP: MPI smoke (2 ranks)",
      "type": "shell",
      "command": "mpiexec",
      "args": [
        "-n",
        "2",
        "python",
        "simulations/mpi_check.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
