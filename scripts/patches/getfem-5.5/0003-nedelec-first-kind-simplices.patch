diff --git a/src/getfem_fem.cc b/src/getfem_fem.cc
--- a/src/getfem_fem.cc
+++ b/src/getfem_fem.cc
@@ -2480,5 +2480,237 @@
 
   /* ******************************************************************** */
+  /* ******************************************************************** */
+  /* Higher-order simplicial Nedelec 1st kind, nodal (experimental).      */
+  /* k is the polynomial subdegree; k=0 aliases FEM_NEDELEC(n).          */
+  /* ******************************************************************** */
+
+  struct nedelec1k_ : public fem<base_poly> {
+    dim_type nc, k;
+    base_small_vector norient;
+    std::vector<base_small_vector> local_directions;
+    std::vector<int> modes, face_numbers;
+    mutable bgeot::pgeotrans_precomp pgp;
+    mutable bgeot::pgeometric_trans pgt_stored;
+    mutable pfem_precomp pfp;
+
+    nedelec1k_(dim_type n, dim_type order);
+    virtual void mat_trans(base_matrix &M, const base_matrix &G,
+                           bgeot::pgeometric_trans pgt) const;
+  };
+
+  nedelec1k_::nedelec1k_(dim_type n, dim_type order) : nc(n), k(order) {
+    GMM_ASSERT1((nc == 2 || nc == 3) && k >= 1,
+                "Nedelec 1st kind: only triangles/tetrahedra, k >= 1");
+    pgt_stored = nullptr;
+    cvr = bgeot::simplex_of_reference(nc);
+    dim_ = cvr->structure()->dim();
+    init_cvs_node();
+    es_degree = k+1;
+    is_pol = true;
+    is_standard_fem = is_lag = is_equiv = false;
+    ntarget_dim = nc;
+    vtype = VECTORIAL_DUAL_TYPE;
+
+    gmm::resize(norient, nc);
+    norient[0] = M_PI;
+    for (unsigned j = 1; j < nc; ++j)
+      norient[j] = norient[j-1] * M_PI;
+
+    typedef std::vector<base_poly> vector_poly;
+    std::vector<vector_poly> generators;
+    PK_fem_ PK(nc, k);
+    for (size_type i = 0; i < PK.base().size(); ++i)
+      for (unsigned m = 0; m < nc; ++m) {
+        vector_poly q(nc, base_poly(nc,0));
+        q[m] = PK.base()[i];
+        generators.push_back(q);
+      }
+
+    // Koszul representatives for homogeneous degree k+1 forms:
+    // 2D: (-y,x)*P_k^hom; 3D: xy,xz syzygies for every monomial,
+    // plus yz syzygies only when the x-exponent is zero.
+    bgeot::power_index pi(nc);
+    do {
+      if (pi.degree() == k) {
+        base_poly mon(nc,0);
+        mon.add_monomial(scalar_type(1), pi);
+        const base_poly x(nc,1,0), y(nc,1,1);
+        vector_poly xy(nc, base_poly(nc,0));
+        xy[0] -= mon*y;
+        xy[1] += mon*x;
+        generators.push_back(xy);
+        if (nc == 3) {
+          const base_poly z(nc,1,2);
+          vector_poly xz(nc, base_poly(nc,0));
+          xz[0] -= mon*z;
+          xz[2] += mon*x;
+          generators.push_back(xz);
+          if (pi[0] == 0) {
+            vector_poly yz(nc, base_poly(nc,0));
+            yz[1] -= mon*z;
+            yz[2] += mon*y;
+            generators.push_back(yz);
+          }
+        }
+      }
+      for (unsigned j = 0; j < nc; ++j) {
+        ++pi[j];
+        if (pi[j] == k+1) pi[j] = 0;
+        else break;
+      }
+    } while (pi.degree() != 0);
+
+    size_type nddl = (nc == 2)
+      ? size_type(k+1)*size_type(k+3)
+      : size_type(k+1)*size_type(k+3)*size_type(k+4)/2;
+    GMM_ASSERT2(generators.size() == nddl,
+                "Nedelec1k: polynomial generator dimension mismatch");
+
+    base_matrix A(nddl, nddl);
+    size_type row = 0;
+
+    auto add_eval = [&](const base_node &pt, const base_small_vector &t,
+                        pdof_description desc, int mode, int face) {
+      GMM_ASSERT2(row < nddl, "Nedelec1k: excess interpolation nodes");
+      for (size_type j = 0; j < nddl; ++j) {
+        scalar_type val = 0;
+        for (unsigned m = 0; m < nc; ++m)
+          val += t[m] * generators[j][m].eval(pt.begin());
+        A(row,j) = val;
+      }
+      add_node(desc, pt);
+      local_directions.push_back(t);
+      modes.push_back(mode);
+      face_numbers.push_back(face);
+      ++row;
+    };
+
+    bgeot::pconvex_ref lattice
+      = bgeot::simplex_of_reference(nc, bgeot::short_type(k+2));
+    for (size_type ip = 0; ip < lattice->nb_points(); ++ip) {
+      const base_node &pt = lattice->points()[ip];
+      std::vector<unsigned> vertices;
+      for (unsigned facet = 0; facet <= nc; ++facet)
+        if (gmm::abs(lattice->is_in_face(facet, pt)) >= 1E-10)
+          vertices.push_back(facet);
+      if (vertices.size() == 1) continue; // vertices have no edge DOF
+      if (vertices.size() == 2) {
+        base_small_vector t(nc);
+        for (unsigned m = 0; m < nc; ++m)
+          t[m] = cvr->points()[vertices[1]][m]
+               - cvr->points()[vertices[0]][m];
+        add_eval(pt, t, edge_component_dof(nc), 0, -1);
+      } else if (nc == 3 && vertices.size() == 3) {
+        // Two independent tangential components at each face-interior
+        // lattice node; geometry-aware physical directions in mat_trans.
+        unsigned facet = 0;
+        for (; facet <= nc; ++facet)
+          if (gmm::abs(lattice->is_in_face(facet, pt)) < 1E-10) break;
+        GMM_ASSERT2(facet <= nc, "Nedelec1k: no face identified");
+        for (unsigned axis = 0; axis < 2; ++axis) {
+          base_small_vector t(nc);
+          for (unsigned m = 0; m < nc; ++m)
+            t[m] = cvr->points()[vertices[axis+1]][m]
+                 - cvr->points()[vertices[0]][m];
+          add_eval(pt, t, to_coord_dof(edge_component_dof(nc), axis),
+                   1+int(axis), int(facet));
+        }
+      } else if (vertices.size() == size_type(nc+1)) {
+        for (unsigned m = 0; m < nc; ++m) {
+          base_small_vector t(nc);
+          gmm::clear(t);
+          t[m] = 1;
+          add_eval(pt, t, to_coord_dof(lagrange_dof(nc), m),
+                   3+int(m), -1);
+        }
+      } else {
+        GMM_ASSERT2(false, "Nedelec1k: unexpected simplex lattice entity");
+      }
+    }
+    GMM_ASSERT2(row == nddl, "Nedelec1k: interpolation cardinality");
+    gmm::lu_inverse(A);
+    base_.resize(nddl*nc, base_poly(nc,0));
+    for (size_type i = 0; i < nddl; ++i)
+      for (size_type j = 0; j < nddl; ++j)
+        for (unsigned m = 0; m < nc; ++m)
+          if (gmm::abs(A(j,i)) > 1E-14)
+            base_[i + m*nddl] += generators[j][m] * A(j,i);
+  }
+
+  void nedelec1k_::mat_trans(base_matrix &M, const base_matrix &G,
+                             bgeot::pgeometric_trans pgt) const {
+    GMM_ASSERT1(dim_type(G.nrows()) == nc,
+                "Nedelec1k: invalid geometric dimension");
+    if (pgt != pgt_stored) {
+      pgt_stored = pgt;
+      pgp = bgeot::geotrans_precomp(pgt, node_tab(0), 0);
+      pfp = fem_precomp(std::make_shared<nedelec1k_>(nc, k), node_tab(0), 0);
+    }
+    fem_interpolation_context ctx(pgp, pfp, 0, G, 0);
+    for (size_type i = 0; i < nb_dof(0); ++i) {
+      ctx.set_ii(i);
+      base_small_vector t(nc), v(nc);
+      gmm::clear(t);
+      if (modes[i] == 0) { // edge direction, oriented globally
+        gmm::mult(ctx.K(), local_directions[i], t);
+        t /= gmm::vect_norm2(t);
+        if (gmm::vect_sp(t, norient) < 0) t *= scalar_type(-1);
+      } else if (modes[i] == 1 || modes[i] == 2) {
+        // A global frame intrinsic to the physical face, independent
+        // of the local simplex vertex ordering.
+        base_small_vector nn(nc);
+        gmm::mult(gmm::transposed(ctx.B()),
+                  cvr->normals()[face_numbers[i]], nn);
+        nn /= gmm::vect_norm2(nn);
+        if (gmm::vect_sp(nn, norient) < 0) nn *= scalar_type(-1);
+        unsigned axis = 0;
+        for (unsigned j = 1; j < nc; ++j)
+          if (gmm::abs(nn[j]) < gmm::abs(nn[axis])) axis = j;
+        t[axis] = 1;
+        for (unsigned j = 0; j < nc; ++j) t[j] -= nn[axis]*nn[j];
+        t /= gmm::vect_norm2(t);
+        if (modes[i] == 2) {
+          base_small_vector tt(t);
+          t[0] = nn[1]*tt[2] - nn[2]*tt[1];
+          t[1] = nn[2]*tt[0] - nn[0]*tt[2];
+          t[2] = nn[0]*tt[1] - nn[1]*tt[0];
+        }
+      } else {
+        t[size_type(modes[i]-3)] = 1;
+      }
+      gmm::mult(gmm::transposed(ctx.B()), t, v);
+      const bgeot::base_tensor &tt = pfp->val(i);
+      for (size_type j = 0; j < nb_dof(0); ++j) {
+        scalar_type value = 0;
+        for (unsigned m = 0; m < nc; ++m) value += tt(j,m) * v[m];
+        M(j,i) = value;
+      }
+    }
+    gmm::lu_inverse(M);
+  }
+
+  static pfem nedelec1k(fem_param_list &params,
+                         std::vector<dal::pstatic_stored_object> &dependencies) {
+    GMM_ASSERT1(params.size() == 2, "FEM_NEDELEC1(N,K) expects two integers");
+    GMM_ASSERT1(params[0].type() == 0 && params[1].type() == 0,
+                "Nedelec1k: parameters must be integers");
+    int n = int(::floor(params[0].num() + 0.01));
+    int k = int(::floor(params[1].num() + 0.01));
+    GMM_ASSERT1((n == 2 || n == 3) && double(n) == params[0].num(),
+                "Nedelec1k: only dimension 2/3");
+    GMM_ASSERT1(k >= 0 && k < 100 && double(k) == params[1].num(),
+                "Nedelec1k: bad order");
+    if (k == 0) {
+      std::stringstream name;
+      name << "FEM_NEDELEC(" << n << ")";
+      return fem_descriptor(name.str());
+    }
+    pfem p = std::make_shared<nedelec1k_>(dim_type(n), dim_type(k));
+    dependencies.push_back(p->ref_convex(0));
+    dependencies.push_back(p->node_tab(0));
+    return p;
+  }
+
   /*    P1 element with a bubble base function on a face : type lagrange  */
   /* ******************************************************************** */
 
@@ -4657,4 +4889,5 @@
       add_suffix("RT0Q", P1_RT0Q);
       add_suffix("NEDELEC", P1_nedelec);
+      add_suffix("NEDELEC1", nedelec1k);
       add_suffix("PYRAMID_QK", pyramid_QK_fem);
       add_suffix("PYRAMID_QK_DISCONTINUOUS", pyramid_QK_disc_fem);
