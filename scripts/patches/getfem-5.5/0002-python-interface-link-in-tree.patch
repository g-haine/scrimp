diff --git a/interface/src/python/setup.py.in b/interface/src/python/setup.py.in
--- a/interface/src/python/setup.py.in
+++ b/interface/src/python/setup.py.in
@@ -37,6 +37,8 @@
 cclibopts += '@LDFLAGS@'.split()
 
-libnames = ['getfemint','getfem']
+# Always link the in-tree GetFEM archives, never a stale installed copy.
+# They are passed explicitly as objects to setuptools below.
+libnames = []
 libnames += [l[2:] for l in cclibopts if l.startswith("-l")]
 libdirs  = [l[2:] for l in cclibopts if l.startswith("-L")]
 libdirs += [l for l in cclibopts if not l.startswith("-")]
@@ -62,7 +64,9 @@
 getfemmod = Extension('_getfem',
                       include_dirs = ['@top_srcdir@/src/getfem','../../../src/getfem','@srcdir@/..','@srcdir@',npy_include_dir],
+                      extra_objects = ['../.libs/libgetfemint.a',
+                                       '../../../src/.libs/libgetfem.a'],
                       libraries = libnames,
                       library_dirs = libdirs,
                       sources = ['getfem_python_c.c'],
                       @PYTHON_EXTRA_EXT_PARAM@)
 
